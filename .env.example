# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HORO_API_TOKEN=replace-with-a-long-random-token
HORO_DATA_DIR=/data
HORO_HOST=0.0.0.0
HORO_PORT=8088
HORO_ALLOWED_ORIGINS=
HORO_TRUST_PROXY=false
HORO_GRAPHIFY_ENABLED=true
HORO_GRAPHIFY_COMMAND=graphify
HORO_MAX_REQUEST_BYTES=2097152

